{
  "name": "dsh-octop-memory",
  "version": "0.1.2",
  "private": false,
  "description": "DSH (DeepSeek Harness) plugin for octop-memory: recall shared memory before each turn and report each turn afterwards.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib/text.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "author": "ArvinQi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArvinQi/dsh-octop-memory.git"
  },
  "homepage": "https://github.com/ArvinQi/dsh-octop-memory#readme",
  "bugs": {
    "url": "https://github.com/ArvinQi/dsh-octop-memory/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "octop",
    "memory",
    "mcp",
    "plugin"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
